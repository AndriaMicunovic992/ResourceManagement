# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/databob?schema=public"
# Must be set in production (>=32 chars). The server refuses to boot without it.
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"

# --- Optional ---
PORT=3000
# Comma-separated allowed origins. Unset = same-origin only in production,
# reflect-origin in dev (for the Vite dev server on :5173).
CORS_ORIGIN="http://localhost:5173"
# Session token lifetime (any @fastify/jwt expiresIn value). Default 7d.
# TOKEN_TTL="7d"
# Set to "false" to disable email/password login (Microsoft-only). Default on,
# which keeps local login available for test personas and break-glass admin.
# ALLOW_LOCAL_AUTH=true
# Required to run `npm run db:seed` when NODE_ENV=production (it wipes data).
# ALLOW_SEED=false

# --- Microsoft Entra SSO (optional) ---
# Sign-in with Microsoft activates only when all four are set. Until then the
# Microsoft button stays hidden and the SSO endpoints report disabled.
# ENTRA_TENANT_ID="your-tenant-guid"          # single-tenant: locks sign-in to this tenant
# ENTRA_CLIENT_ID="app-registration-client-id"
# ENTRA_CLIENT_SECRET="app-registration-secret"
# ENTRA_REDIRECT_URI="https://your-app.example.com/api/auth/microsoft/callback"
# Where to send the browser after the callback. Empty = same origin (prod).
# In dev, point at the Vite server: http://localhost:5173
# CLIENT_URL="http://localhost:5173"
