generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  minPlanningDate String?
  maxPlanningDate String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members     OrgMember[]
  customers   Customer[]
  projects    Project[]
  resources   Resource[]
  teams       Team[]
  skills      Skill[]
  personSkills PersonSkill[]
  needs       Need[]
  assignments Assignment[]
  oneOnOnes   OneOnOne[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime @default(now())

  memberships        OrgMember[]
  authoredOneOnOnes  OneOnOne[]  @relation("AuthoredOneOnOnes")
}

model OrgMember {
  id   String @id @default(cuid())
  role String @default("member")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("realised")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projects Project[]

  @@index([orgId])
}

model Project {
  id         String   @id @default(cuid())
  name       String
  startMonth String
  endMonth   String
  status     String   @default("realised")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  responsiblePersonId String?
  responsiblePerson   Resource? @relation("ProjectResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  needs Need[]

  @@index([orgId])
  @@index([customerId])
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  capacity  Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  roles       ResourceRole[]
  assignments Assignment[]
  personSkills PersonSkill[]
  oneOnOnes   OneOnOne[]
  responsibleProjects Project[] @relation("ProjectResponsible")

  @@index([orgId])
  @@index([teamId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  resources Resource[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Skill {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  personSkills PersonSkill[]

  @@unique([orgId, name])
  @@index([orgId])
}

model PersonSkill {
  id         String   @id @default(cuid())
  level      Int
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  skillId    String
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
  @@index([orgId])
}

model ResourceRole {
  id        String @id @default(cuid())
  domain    String
  role      String
  seniority String

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model Need {
  id               String   @id @default(cuid())
  domain           String   @default("Web")
  role             String   @default("FE")
  seniority        String   @default("Medior")
  label            String?
  startMonth       String?
  endMonth         String?
  status           String   @default("realised")
  monthAllocations Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  assignments Assignment[]

  @@index([orgId])
  @@index([projectId])
}

model Assignment {
  id               String   @id @default(cuid())
  monthAllocations Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  needId String
  need   Need @relation(fields: [needId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([needId, resourceId])
  @@index([orgId])
  @@index([needId])
  @@index([resourceId])
}

model OneOnOne {
  id                    String   @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resourceId            String
  resource              Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorUserId          String
  authorUser            User     @relation("AuthoredOneOnOnes", fields: [authorUserId], references: [id], onDelete: Restrict)
  meetingDate           DateTime
  goodSides             String?
  badSides              String?
  suggestions           String?
  generalStatus         String?
  personalNotes         String?
  careerDevelopment     String?
  managerPersonalNotes  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([orgId])
  @@index([resourceId])
  @@index([authorUserId])
}
