generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  minPlanningDate String?
  maxPlanningDate String?
  performanceTrendDefaultMonths Int @default(12)
  performanceTrendDefaultKind String @default("rolling_months")
  // In-app reminder schedules: fire on ticks of `every` × unit, anchored at a
  // start date; an item is due when nothing happened since the latest tick.
  // Null unit/every = reminder off.
  oneOnOneReminderEvery Int?
  oneOnOneReminderUnit  String? // daily | weekly | monthly
  oneOnOneReminderStart String? // "YYYY-MM-DD"
  pmLogReminderEvery    Int?
  pmLogReminderUnit     String?
  pmLogReminderStart    String?
  performanceTrendDefaultFrom String?
  performanceTrendDefaultTo   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members     OrgMember[]
  roles       Role[]
  domains     Domain[]
  jobRoles    JobRole[]
  seniorities Seniority[]
  customers   Customer[]
  projects    Project[]
  resources   Resource[]
  teams       Team[]
  skills      Skill[]
  personSkills PersonSkill[]
  needs       Need[]
  assignments Assignment[]
  oneOnOnes   OneOnOne[]
  logs        Log[]
  performanceLogCategories PerformanceLogCategory[]
  personManagers PersonManager[]
  evaluations Evaluation[]
  invites     Invite[]
  logComments   LogComment[]
  followUps     FollowUp[]
  careerEntries CareerEntry[]
  clientSignals ClientSignal[]
  reminderDismissals ReminderDismissal[]
  customerReviews CustomerReview[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Nullable: SSO-provisioned users authenticate via Microsoft and have no
  // local password. Guard local login against null before bcrypt compare.
  password  String?
  name      String
  avatar    String?
  // Entra/Microsoft object id (the `oid` claim). Stable per user per tenant —
  // the canonical link for SSO, matched on before email.
  microsoftId  String? @unique
  // "local" | "microsoft" — how this account was provisioned / signs in.
  authProvider String  @default("local")
  createdAt DateTime @default(now())

  memberships        OrgMember[]
  authoredOneOnOnes  OneOnOne[]  @relation("AuthoredOneOnOnes")
  authoredLogs       Log[]       @relation("AuthoredLogs")
  resources          Resource[]  @relation("UserResources")
  createdEvaluations   Evaluation[] @relation("EvaluationCreator")
  finalizedEvaluations Evaluation[] @relation("EvaluationFinalizer")
  sentInvites          Invite[]
  authoredLogComments   LogComment[]   @relation("AuthoredLogComments")
  createdFollowUps      FollowUp[]     @relation("FollowUpCreator")
  authoredCareerEntries CareerEntry[]  @relation("AuthoredCareerEntries")
  authoredClientSignals ClientSignal[] @relation("AuthoredClientSignals")
  reminderDismissals    ReminderDismissal[] @relation("ReminderDismissals")
  authoredCustomerReviews CustomerReview[] @relation("AuthoredCustomerReviews")
  // A responsible person is any org user (not necessarily a staffable Resource).
  responsibleCustomers  Customer[] @relation("CustomerResponsibleUser")
  responsibleProjects   Project[]  @relation("ProjectResponsibleUser")
  // Likewise, a manager (of people / teams) is any org user.
  managedTeams          Team[]          @relation("TeamManagerUser")
  managedPeople         PersonManager[] @relation("PersonManagerUser")
}

model OrgMember {
  id   String @id @default(cuid())
  role String @default("member")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// A role is a named permission matrix, scoped to one org. The four system roles
// (owner/admin/member/viewer) are seeded per org and can be tuned; admins can
// also add custom roles. `OrgMember.role` references this by `key`.
// `permissions` is { [segment]: { scope: none|own|team|all, create, edit, delete } }.
// `level` is the legacy 1-4 rank, kept as a fallback gate while enforcement
// migrates from role-level checks to the matrix.
model Role {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String
  name        String
  level       Int
  isSystem    Boolean  @default(false)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, key])
  @@index([orgId])
}

// Pending org access for an email that may not have an account yet. Created by
// an admin; consumed on first sign-in (Microsoft or local) when the verified
// email matches, which creates the OrgMember. Underpins invite-first SSO.
model Invite {
  id              String    @id @default(cuid())
  email           String
  role            String    @default("member")
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?

  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invitedByUserId String?
  invitedBy       User?     @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([email, orgId])
  @@index([orgId])
  @@index([email])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("realised")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  responsibleUserId String?
  responsibleUser   User? @relation("CustomerResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  projects    Project[]
  logs        Log[]
  evaluations Evaluation[]
  clientSignals ClientSignal[]
  reviews     CustomerReview[]

  @@index([orgId])
  @@index([responsibleUserId])
}

model Project {
  id         String   @id @default(cuid())
  name       String
  startMonth String
  endMonth   String
  status     String   @default("realised")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  responsibleUserId String?
  responsibleUser   User? @relation("ProjectResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  needs       Need[]
  logs        Log[]
  evaluations Evaluation[]

  @@index([orgId])
  @@index([customerId])
  @@index([responsibleUserId])
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  capacity  Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  teams Team[] @relation("ResourceTeams")

  userId String?
  user   User?   @relation("UserResources", fields: [userId], references: [id], onDelete: SetNull)

  roles       ResourceRole[]
  assignments Assignment[]
  personSkills PersonSkill[]
  oneOnOnes   OneOnOne[]
  logs        Log[]
  managerLinks       PersonManager[] @relation("PersonSide")
  evaluations        Evaluation[] @relation("EvaluationSubject")
  followUps     FollowUp[]
  careerEntries CareerEntry[]
  clientSignals ClientSignal[]

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  resources Resource[] @relation("ResourceTeams")

  managerUserId String?
  managerUser   User? @relation("TeamManagerUser", fields: [managerUserId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId])
  @@index([managerUserId])
}

model PersonManager {
  personId      String
  person        Resource @relation("PersonSide", fields: [personId], references: [id], onDelete: Cascade)
  // The manager is any org User (a login user), not necessarily a staffable
  // Resource — same model as a customer/project responsible person.
  managerUserId String
  managerUser   User @relation("PersonManagerUser", fields: [managerUserId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([personId, managerUserId])
  @@index([managerUserId])
  @@index([orgId])
}

model Skill {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  personSkills PersonSkill[]

  @@unique([orgId, name])
  @@index([orgId])
}

model PersonSkill {
  id         String   @id @default(cuid())
  level      Int
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  skillId    String
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
  @@index([orgId])
}

model ResourceRole {
  id        String @id @default(cuid())
  domain    String
  role      String
  seniority String

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

// --- Editable role taxonomy (per org) -------------------------------------
// Domains / job roles / seniorities used to define ResourceRole and Need are
// org-scoped and admin-editable. ResourceRole.domain/role/seniority and
// Need.domain/role/seniority still store the *name* as a string; these tables
// are the source of truth for the pickers, planner colors, and seniority
// ordering. Renames cascade to the string columns (see taxonomy.service).
model Domain {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  color     String   // hex, drives planner bar colors
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobRoles  JobRole[]

  @@unique([orgId, name])
  @@index([orgId])
}

model JobRole {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, domainId, name])
  @@index([orgId])
  @@index([domainId])
}

model Seniority {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  shortLabel String
  // Rank used both for display order and need-matching (higher = more senior).
  level      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

model Need {
  id               String   @id @default(cuid())
  domain           String   @default("Web")
  role             String   @default("FE")
  seniority        String   @default("Medior")
  label            String?
  startMonth       String?
  endMonth         String?
  status           String   @default("realised")
  monthAllocations Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  assignments Assignment[]

  @@index([orgId])
  @@index([projectId])
}

model Assignment {
  id               String   @id @default(cuid())
  monthAllocations Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  needId String
  need   Need @relation(fields: [needId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([needId, resourceId])
  @@index([orgId])
  @@index([needId])
  @@index([resourceId])
}

model OneOnOne {
  id                    String   @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resourceId            String
  resource              Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorUserId          String
  authorUser            User     @relation("AuthoredOneOnOnes", fields: [authorUserId], references: [id], onDelete: Restrict)
  meetingDate           DateTime
  // 1-5 manager pulse for this check-in. Deliberately distinct from formal
  // evaluation scores — never aggregate the two together.
  overallScore          Int?
  // 1-5, the employee's self-reported work satisfaction (manager records it).
  workSatisfaction      Int?
  wentWell              String?
  wentBad               String?
  // Creator-only note: stripped for everyone else, including admins and
  // impersonated sessions.
  privateNote           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  logs Log[]
  careerEntries     CareerEntry[]
  followUpsCreated  FollowUp[] @relation("FollowUpCreatedIn")
  followUpsResolved FollowUp[] @relation("FollowUpResolvedIn")

  @@index([orgId])
  @@index([resourceId])
  @@index([authorUserId])
}

model Log {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Null = a general entry about the customer/project, not a specific person.
  resourceId      String?
  resource        Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorUserId    String
  authorUser      User     @relation("AuthoredLogs", fields: [authorUserId], references: [id], onDelete: Restrict)
  content         String
  kind            String
  // One incident can evidence several dimensions — many-to-many by design.
  categories      PerformanceLogCategory[] @relation("LogCategories")
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  jiraUrl         String?
  oneOnOneId      String?
  oneOnOne        OneOnOne? @relation(fields: [oneOnOneId], references: [id], onDelete: Cascade)
  customerReviewId String?
  customerReview   CustomerReview? @relation(fields: [customerReviewId], references: [id], onDelete: SetNull)
  evaluationId    String?
  evaluation      Evaluation? @relation("EvaluationLogs", fields: [evaluationId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments LogComment[]

  @@index([orgId])
  @@index([resourceId])
  @@index([authorUserId])
  @@index([oneOnOneId])
  @@index([customerReviewId])
  @@index([evaluationId])
}

// Thread on a log entry. v1 participants: the author (PM), the subject's
// managers, and admins — the subject employee neither sees nor comments;
// their manager mediates and documents the outcome.
model LogComment {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  logId        String
  log          Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User     @relation("AuthoredLogComments", fields: [authorUserId], references: [id], onDelete: Restrict)
  content      String
  createdAt    DateTime @default(now())

  @@index([orgId])
  @@index([logId])
}

// Action item about a person. Created in a 1:1 or standalone; surfaces in
// every 1:1 cockpit until resolved.
model FollowUp {
  id                   String    @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resourceId           String
  resource             Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdByUserId      String
  createdByUser        User      @relation("FollowUpCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  content              String
  status               String    @default("open") // open | resolved
  oneOnOneId           String?
  oneOnOne             OneOnOne? @relation("FollowUpCreatedIn", fields: [oneOnOneId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  resolvedInOneOnOneId String?
  resolvedInOneOnOne   OneOnOne? @relation("FollowUpResolvedIn", fields: [resolvedInOneOnOneId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([orgId])
  @@index([resourceId])
  @@index([status])
}

// Append-only career thread per person, spanning 1:1s ("monitored over time").
// kind "goal" entries carry a goalStatus lifecycle; "note" entries don't.
model CareerEntry {
  id           String    @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User      @relation("AuthoredCareerEntries", fields: [authorUserId], references: [id], onDelete: Restrict)
  content      String
  kind         String    @default("note") // note | goal
  goalStatus   String?   // active | achieved | dropped (goals only)
  oneOnOneId   String?
  oneOnOne     OneOnOne? @relation(fields: [oneOnOneId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orgId])
  @@index([resourceId])
}

// PM-perceived client satisfaction with one person's work, one entry per
// month. Hidden from the subject; feeds the customer page and review evidence.
model ClientSignal {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  month        String   // "YYYY-MM"
  rating       Int      // 1-5
  note         String?
  authorUserId String
  authorUser   User     @relation("AuthoredClientSignals", fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([resourceId, customerId, month])
  @@index([orgId])
  @@index([customerId])
  @@index([resourceId])
}

model PerformanceLogCategory {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grouping    String?
  name        String
  description String?
  weight      Float    @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs                Log[] @relation("LogCategories")
  evaluationSnapshots EvaluationCategorySnapshot[]

  @@unique([orgId, grouping, name])
  @@index([orgId])
}

model Evaluation {
  id                  String   @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  resourceId          String
  resource            Resource @relation("EvaluationSubject", fields: [resourceId], references: [id], onDelete: Cascade)

  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String
  projectId           String?
  project             Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectNameSnapshot String?

  periodStart         DateTime
  periodEnd           DateTime

  state               String    @default("draft")
  createdByUserId     String
  createdByUser       User      @relation("EvaluationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  computedFinal       Float?
  overrideFinal       Float?
  overrideReason      String?
  // 1-5, employee-reported during self-assessment (deliberately on the less
  // frequent evaluation cadence, not on every 1:1).
  compensationSatisfaction Int?

  finalizedAt         DateTime?
  finalizedByUserId   String?
  finalizedByUser     User?     @relation("EvaluationFinalizer", fields: [finalizedByUserId], references: [id], onDelete: Restrict)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  scores              EvaluationScore[]
  categorySnapshots   EvaluationCategorySnapshot[]
  logs                Log[]     @relation("EvaluationLogs")

  @@index([orgId])
  @@index([resourceId])
  @@index([customerId])
  @@index([projectId])
  @@index([state])
}

model EvaluationCategorySnapshot {
  id             String   @id @default(cuid())
  evaluationId   String
  evaluation     Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       PerformanceLogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryNameSnapshot     String
  categoryGroupingSnapshot String?
  weightSnapshot           Float
  sortOrderSnapshot        Int
  createdAt      DateTime @default(now())

  scores         EvaluationScore[]

  @@unique([evaluationId, categoryNameSnapshot, categoryGroupingSnapshot])
  @@index([evaluationId])
}

model EvaluationScore {
  id                 String   @id @default(cuid())
  evaluationId       String
  evaluation         Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  categorySnapshotId String
  categorySnapshot   EvaluationCategorySnapshot @relation(fields: [categorySnapshotId], references: [id], onDelete: Cascade)

  employeeScore      Float?
  employeeComment    String?
  responsibleScore   Float?
  responsibleComment String?
  managerComment     String?

  updatedAt          DateTime @updatedAt

  @@unique([evaluationId, categorySnapshotId])
  @@index([evaluationId])
}

// A user snoozing a reminder item ("on leave this month", etc.). Cadence-based
// reminders treat the dismissal like activity; monthly ones hide for the month.
model ReminderDismissal {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ReminderDismissals", fields: [userId], references: [id], onDelete: Cascade)
  type       String   // oneOnOne | pmUpdate | clientSignal
  resourceId String
  customerId String?
  createdAt  DateTime @default(now())

  @@index([orgId, userId])
}

// A dated PM review session for one customer — the customer-side analog of a
// OneOnOne. Entries logged during the session link back via Log.customerReviewId.
model CustomerReview {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User     @relation("AuthoredCustomerReviews", fields: [authorUserId], references: [id], onDelete: Restrict)
  reviewDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs Log[]

  @@index([orgId])
  @@index([customerId])
}
