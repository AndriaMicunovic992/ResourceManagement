generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  minPlanningDate String?
  maxPlanningDate String?
  performanceTrendDefaultMonths Int @default(12)
  performanceTrendDefaultKind String @default("rolling_months")
  performanceTrendDefaultFrom String?
  performanceTrendDefaultTo   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members     OrgMember[]
  customers   Customer[]
  projects    Project[]
  resources   Resource[]
  teams       Team[]
  skills      Skill[]
  personSkills PersonSkill[]
  needs       Need[]
  assignments Assignment[]
  oneOnOnes   OneOnOne[]
  logs        Log[]
  performanceLogCategories PerformanceLogCategory[]
  personManagers PersonManager[]
  evaluations Evaluation[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime @default(now())

  memberships        OrgMember[]
  authoredOneOnOnes  OneOnOne[]  @relation("AuthoredOneOnOnes")
  authoredLogs       Log[]       @relation("AuthoredLogs")
  resources          Resource[]  @relation("UserResources")
  createdEvaluations   Evaluation[] @relation("EvaluationCreator")
  finalizedEvaluations Evaluation[] @relation("EvaluationFinalizer")
}

model OrgMember {
  id   String @id @default(cuid())
  role String @default("member")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("realised")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  responsiblePersonId String?
  responsiblePerson   Resource? @relation("CustomerResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)

  projects    Project[]
  logs        Log[]
  evaluations Evaluation[]

  @@index([orgId])
  @@index([responsiblePersonId])
}

model Project {
  id         String   @id @default(cuid())
  name       String
  startMonth String
  endMonth   String
  status     String   @default("realised")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  responsiblePersonId String?
  responsiblePerson   Resource? @relation("ProjectResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  needs       Need[]
  logs        Log[]
  evaluations Evaluation[]

  @@index([orgId])
  @@index([customerId])
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  capacity  Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  teams Team[] @relation("ResourceTeams")

  userId String?
  user   User?   @relation("UserResources", fields: [userId], references: [id], onDelete: SetNull)

  roles       ResourceRole[]
  assignments Assignment[]
  personSkills PersonSkill[]
  oneOnOnes   OneOnOne[]
  logs        Log[]
  responsibleProjects  Project[]  @relation("ProjectResponsible")
  responsibleCustomers Customer[] @relation("CustomerResponsible")
  managedTeams Team[] @relation("TeamManager")
  managerLinks       PersonManager[] @relation("PersonSide")
  managedPersonLinks PersonManager[] @relation("ManagerSide")
  evaluations        Evaluation[] @relation("EvaluationSubject")

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  resources Resource[] @relation("ResourceTeams")

  managerId String?
  manager   Resource? @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId])
  @@index([managerId])
}

model PersonManager {
  personId  String
  person    Resource @relation("PersonSide", fields: [personId], references: [id], onDelete: Cascade)
  managerId String
  manager   Resource @relation("ManagerSide", fields: [managerId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([personId, managerId])
  @@index([managerId])
  @@index([orgId])
}

model Skill {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  personSkills PersonSkill[]

  @@unique([orgId, name])
  @@index([orgId])
}

model PersonSkill {
  id         String   @id @default(cuid())
  level      Int
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  skillId    String
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([resourceId, skillId])
  @@index([resourceId])
  @@index([skillId])
  @@index([orgId])
}

model ResourceRole {
  id        String @id @default(cuid())
  domain    String
  role      String
  seniority String

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model Need {
  id               String   @id @default(cuid())
  domain           String   @default("Web")
  role             String   @default("FE")
  seniority        String   @default("Medior")
  label            String?
  startMonth       String?
  endMonth         String?
  status           String   @default("realised")
  monthAllocations Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  assignments Assignment[]

  @@index([orgId])
  @@index([projectId])
}

model Assignment {
  id               String   @id @default(cuid())
  monthAllocations Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  needId String
  need   Need @relation(fields: [needId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([needId, resourceId])
  @@index([orgId])
  @@index([needId])
  @@index([resourceId])
}

model OneOnOne {
  id                    String   @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resourceId            String
  resource              Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorUserId          String
  authorUser            User     @relation("AuthoredOneOnOnes", fields: [authorUserId], references: [id], onDelete: Restrict)
  meetingDate           DateTime
  generalStatus         String?
  personalNotes         String?
  careerDevelopment     String?
  managerPersonalNotes  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  logs Log[]

  @@index([orgId])
  @@index([resourceId])
  @@index([authorUserId])
}

model Log {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorUserId    String
  authorUser      User     @relation("AuthoredLogs", fields: [authorUserId], references: [id], onDelete: Restrict)
  content         String
  kind            String
  categoryId      String?
  category        PerformanceLogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  jiraUrl         String?
  oneOnOneId      String?
  oneOnOne        OneOnOne? @relation(fields: [oneOnOneId], references: [id], onDelete: Cascade)
  evaluationId    String?
  evaluation      Evaluation? @relation("EvaluationLogs", fields: [evaluationId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId])
  @@index([resourceId])
  @@index([authorUserId])
  @@index([oneOnOneId])
  @@index([categoryId])
  @@index([evaluationId])
}

model PerformanceLogCategory {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grouping    String?
  name        String
  description String?
  weight      Float    @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs                Log[]
  evaluationSnapshots EvaluationCategorySnapshot[]

  @@unique([orgId, grouping, name])
  @@index([orgId])
}

model Evaluation {
  id                  String   @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  resourceId          String
  resource            Resource @relation("EvaluationSubject", fields: [resourceId], references: [id], onDelete: Cascade)

  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String
  projectId           String?
  project             Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectNameSnapshot String?

  periodStart         DateTime
  periodEnd           DateTime

  state               String    @default("draft")
  createdByUserId     String
  createdByUser       User      @relation("EvaluationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  computedFinal       Float?
  overrideFinal       Float?
  overrideReason      String?

  finalizedAt         DateTime?
  finalizedByUserId   String?
  finalizedByUser     User?     @relation("EvaluationFinalizer", fields: [finalizedByUserId], references: [id], onDelete: Restrict)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  scores              EvaluationScore[]
  categorySnapshots   EvaluationCategorySnapshot[]
  logs                Log[]     @relation("EvaluationLogs")

  @@index([orgId])
  @@index([resourceId])
  @@index([customerId])
  @@index([projectId])
  @@index([state])
}

model EvaluationCategorySnapshot {
  id             String   @id @default(cuid())
  evaluationId   String
  evaluation     Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       PerformanceLogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryNameSnapshot     String
  categoryGroupingSnapshot String?
  weightSnapshot           Float
  sortOrderSnapshot        Int
  createdAt      DateTime @default(now())

  scores         EvaluationScore[]

  @@unique([evaluationId, categoryNameSnapshot, categoryGroupingSnapshot])
  @@index([evaluationId])
}

model EvaluationScore {
  id                 String   @id @default(cuid())
  evaluationId       String
  evaluation         Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  categorySnapshotId String
  categorySnapshot   EvaluationCategorySnapshot @relation(fields: [categorySnapshotId], references: [id], onDelete: Cascade)

  employeeScore      Float?
  employeeComment    String?
  responsibleScore   Float?
  responsibleComment String?
  managerComment     String?

  updatedAt          DateTime @updatedAt

  @@unique([evaluationId, categorySnapshotId])
  @@index([evaluationId])
}
